# 把这一段追加到 /etc/caddy/Caddyfile 末尾
# 然后: caddy reload --config /etc/caddy/Caddyfile

video.8864k.com {
    tls {
        protocols tls1.2 tls1.3
    }

    reverse_proxy 127.0.0.1:8002 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # 视频流式代理: 不要缓冲, 立即吐字节
        flush_interval -1

        transport http {
            keepalive 120s
            keepalive_idle_conns 64
            compression off
            dial_timeout 10s
            response_header_timeout 600s
        }
    }

    # 客户上传 base64 图/视频可能很大
    request_body {
        max_size 100MB
    }

    # 隐藏服务器信息，避免暴露中间件
    header {
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/video-8864k.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}
