# Required server-side secrets. Customers must never see these values.
UPSTREAM_API_KEY=ark-xxxxxxxxxxxxxxxx
ADMIN_KEY=replace-this-with-a-random-string
RUNTIME_INTERNAL_TOKEN=replace-this-with-another-random-string

# Login protection.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Core runtime.
UPSTREAM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
UPSTREAM_AUTH_MODE=api_key
# Optional IAM generation mode. Set UPSTREAM_AUTH_MODE=iam and use an Endpoint ID.
# IAM mode calls BytePlus with AK/SK through the Ark SDK, so UPSTREAM_API_KEY can stay empty.
UPSTREAM_ENDPOINT_ID=
PUBLIC_DOMAIN=video.example.com
DB_PATH=/data/relay.sqlite
BRAND_NAME=Example Video Relay
CONTROL_PLANE_BASE_URL=http://seedance-relay:8002
VIDEO_PERSIST_MODE=proxy_only

# Optional model aliases. Leave empty to expose and execute native BytePlus model IDs.
# Example: {"short-video-pro":"dreamina-seedance-2-0-260128"}
MODEL_ID_ALIASES_JSON=

# Upload relay. Leave UPLOAD_PUBLIC_BASE_URL empty to use https://PUBLIC_DOMAIN/uploads/...
UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=50
UPLOAD_MAX_AUDIO_MB=15

# Optional server-side asset registration. Customers still only use Relay API keys.
ASSET_AUTO_REGISTER_UPLOADS=false
ASSET_AUTO_REGISTER_PURPOSES=image,video,audio
ASSET_AUTO_REGISTER_WAIT_SECONDS=0
ASSET_AUTO_REGISTER_WAIT_INTERVAL=3
ASSET_AUTO_REGISTER_SKIP_MODERATION=false
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_ACCESS_KEY_SECRET=
MODELARK_ASSET_GROUP_ID=
MODELARK_ASSET_AUTO_CREATE_GROUP=true
MODELARK_ASSET_GROUP_NAME=relay-face-assets
MODELARK_ASSET_GROUP_DESCRIPTION=Relay self-service face asset whitelist
MODELARK_PROJECT_NAME=

# Optional face/material asset ownership controls.
FACE_ASSET_ENFORCE=false
FACE_ASSET_SELF_SERVICE=false
FACE_ASSET_ALLOWLIST=
FACE_ASSET_ENFORCE_ROLES=reference_image,reference_video

# Legacy global markup fallback. Prefer per-customer price_multiplier in admin.
MARKUP_PCT=0.3
