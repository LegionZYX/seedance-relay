FROM python:3.11-slim

WORKDIR /app

# System dependency: curl is used by the container healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements.relay.txt .
RUN pip install --no-cache-dir -r requirements.relay.txt

# Application code.
COPY modelark/ ./modelark/
COPY static/ ./static/
COPY relay_server.py API_DOCS.md create_asset_white_label.py ./

# Runtime data: SQLite, optional local videos, and uploaded relay assets.
RUN mkdir -p /data /data/videos /data/uploads
ENV DB_PATH=/data/relay.sqlite
ENV VIDEO_DIR=/data/videos
ENV UPLOAD_DIR=/data/uploads
ENV PYTHONUNBUFFERED=1

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8002/health || exit 1

CMD ["uvicorn", "relay_server:app", \
     "--host", "0.0.0.0", "--port", "8002", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
